# WeChat 2 iPhone deployment configuration

APP_NAME="WeChat 2"

# Keep this Bundle ID stable after you start using the clone.
BUNDLE_ID="com.kelvin.wechat2.kj7f93c2a8"

# Optional: leave blank. After the one-time Xcode bootstrap on each Mac, the
# scripts discover the Team from a live provisioning profile for this Bundle ID.
TEAM_ID=""

IPA_RELATIVE_PATH="IPA/WeChat.ipa"

# Recommended first-pass setting. Embedded extensions often require their own
# App IDs/profiles/entitlements.
REMOVE_EXTENSIONS="1"

# Save a signed IPA under Output/ as well as installing the app.
EXPORT_SIGNED_IPA="1"

# Smart auto-refresh opens its renewal window this many seconds before the
# verified installed profile expiry. 86400 = 24 hours.
AUTO_REFRESH_WINDOW_SECONDS="86400"
