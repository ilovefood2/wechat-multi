# WeChat 2 iPhone deployment configuration

APP_NAME="WeChat 2"

# Keep this Bundle ID stable after you start using the clone.
BUNDLE_ID="com.kelvin.wechat2.kj7f93c2a8"

# Optional: leave blank. The scripts will try to discover your Personal Team
# after Xcode has created an Apple Development certificate, or read it from
# the generated Xcode project after you select a Team once.
TEAM_ID=""

IPA_RELATIVE_PATH="IPA/WeChat.ipa"

# Recommended first-pass setting. Embedded extensions often require their own
# App IDs/profiles/entitlements.
REMOVE_EXTENSIONS="1"

# Save a signed IPA under Output/ as well as installing the app.
EXPORT_SIGNED_IPA="1"
